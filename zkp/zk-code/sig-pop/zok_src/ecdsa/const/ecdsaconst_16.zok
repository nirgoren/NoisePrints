    P_MODULUS_SQU: P_MODULUS_SQU,
    P256_a: P256_a,
    MODULO_CONST: [ModuloConst{CW_list: P256_CW3, gp_maxword: P256_MAXWORD3, aux_const: P256_AUXCONST3}, ModuloConst{CW_list: P256_CW1, gp_maxword: P256_MAXWORD4, aux_const: P256_AUXCONST4}, ModuloConst{CW_list: P256_CW2, gp_maxword: P256_MAXWORD5, aux_const: P256_AUXCONST5}],
    shift: SHIFT // should equal 1<<W
}

const PointAddConst<P, P_SQU, ZG, NG, AC> CONST_FOR_PA = PointAddConst{
    P_MODULUS: P_MODULUS,
    P_MODULUS_SQU: P_MODULUS_SQU,
    P256_a: P256_a,
    MODULO_CONST: [ModuloConst{CW_list: P256_CW2, gp_maxword: P256_MAXWORD2, aux_const: P256_AUXCONST2},ModuloConst{CW_list: P256_CW3, gp_maxword: P256_MAXWORD3, aux_const: P256_AUXCONST3}, ModuloConst{CW_list: P256_CW1, gp_maxword: P256_MAXWORD4, aux_const: P256_AUXCONST4}, ModuloConst{CW_list: P256_CW2, gp_maxword: P256_MAXWORD5, aux_const: P256_AUXCONST5}],
    shift: SHIFT // should equal 1<<W
}

const ScalarMultConst<P, P_SQU, ZG, NG, AC> CONST_FOR_SCAMUL = ScalarMultConst{
    const_for_pa: CONST_FOR_PA,
    const_for_pd: CONST_FOR_PD
}

const VerifyECDSAConstInner<P, Q, P_SQU, ZG, NG, AC, Nm1, S, LS> CONST_FOR_ECDSA_INNER = VerifyECDSAConstInner{
    const_for_modq: ModuloHelperConst{ moduloconst: ModuloConst{CW_list: P256_CW1, gp_maxword: P256_MAXWORD1, aux_const: P256_AUXCONST1}, shift: SHIFT},
    const_for_scalmul: CONST_FOR_SCAMUL,
    Q_MODULUS: Q_MODULUS,
    P256_G: P256_G
}

const VerifyECDSAConst<P, Q, P_SQU, ZG, NG, AC, Nm1, S, LS> CONST_FOR_ECDSA = VerifyECDSAConst{
    const_for_modq: ModuloHelperConst{ moduloconst: ModuloConst{CW_list: P256_CW1, gp_maxword: P256_MAXWORD1, aux_const: P256_AUXCONST1}, shift: SHIFT},
    const_for_scalmul: CONST_FOR_SCAMUL,
    Q_MODULUS: Q_MODULUS,
    P256_G: P256_G,
    Gpow: Gpow
}