    MODULO_CONST: [ModuloConst{CW_list: P256_CW3, gp_maxword: P256_MAXWORD3, aux_const: P256_AUXCONST3}, ModuloConst{CW_list: P256_CW1, gp_maxword: P256_MAXWORD4, aux_const: P256_AUXCONST4}, ModuloConst{CW_list: P256_CW2, gp_maxword: P256_MAXWORD5, aux_const: P256_AUXCONST5}],
